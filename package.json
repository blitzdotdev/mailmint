{
  "name": "mailmint-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "worker",
    "cli"
  ],
  "scripts": {
    "check": "npm run check -w worker",
    "test": "node scripts/build.mjs --check && npm test -w worker && npm test -w cli",
    "harness": "node harness/run.mjs",
    "deploy": "bash scripts/deploy.sh deploy",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  },
  "devDependencies": {
    "@agent-socket/sdk": "0.2.0",
    "esbuild": "0.28.2"
  }
}
