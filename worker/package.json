{
  "name": "mailmint-worker",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787 --local-upstream localhost:8787 --test-scheduled",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "hono": "^4.6.0",
    "jose": "^6.2.10",
    "postal-mime": "^2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.150.0"
  }
}
